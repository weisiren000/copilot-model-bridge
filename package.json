{
  "name": "copilot-model-bridge",
  "displayName": "Copilot Model Bridge",
  "description": "Bridge OpenAI-compatible chat models into GitHub Copilot Chat as first-class language model providers.",
  "version": "0.1.3",
  "publisher": "weisiren",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/weisiren000/copilot-model-bridge"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "copilot",
    "oai",
    "openai",
    "language model",
    "nvidia",
    "nim",
    "ollama",
    "lm studio",
    "vllm",
    "ai"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "chatProvider",
    "languageModelThinkingPart"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "copilot-model-bridge",
        "displayName": "Copilot Model Bridge",
        "managementCommand": "copilot-model-bridge.openConfigManager"
      }
    ],
    "commands": [
      {
        "command": "copilot-model-bridge.manage",
        "title": "Manage Providers",
        "category": "Copilot Model Bridge",
        "icon": "$(settings-gear)"
      },
      {
        "command": "copilot-model-bridge.openConfigManager",
        "title": "Open Config Manager",
        "category": "Copilot Model Bridge",
        "icon": "$(layout)"
      },
      {
        "command": "copilot-model-bridge.quickManage",
        "title": "Quick Manage Providers",
        "category": "Copilot Model Bridge",
        "icon": "$(list-selection)"
      },
      {
        "command": "copilot-model-bridge.addProvider",
        "title": "Add Provider",
        "category": "Copilot Model Bridge",
        "icon": "$(add)"
      },
      {
        "command": "copilot-model-bridge.removeProvider",
        "title": "Remove Provider",
        "category": "Copilot Model Bridge",
        "icon": "$(trash)"
      },
      {
        "command": "copilot-model-bridge.editProvider",
        "title": "Edit Provider",
        "category": "Copilot Model Bridge",
        "icon": "$(edit)"
      },
      {
        "command": "copilot-model-bridge.addModel",
        "title": "Add Model",
        "category": "Copilot Model Bridge",
        "icon": "$(add)"
      },
      {
        "command": "copilot-model-bridge.editModel",
        "title": "Edit Model",
        "category": "Copilot Model Bridge",
        "icon": "$(edit)"
      },
      {
        "command": "copilot-model-bridge.duplicateModel",
        "title": "Duplicate Model",
        "category": "Copilot Model Bridge",
        "icon": "$(copy)"
      },
      {
        "command": "copilot-model-bridge.validateConfig",
        "title": "Validate Provider Config",
        "category": "Copilot Model Bridge",
        "icon": "$(checklist)"
      },
      {
        "command": "copilot-model-bridge.importModelsFromJson",
        "title": "Import Models from JSON",
        "category": "Copilot Model Bridge",
        "icon": "$(json)"
      },
      {
        "command": "copilot-model-bridge.removeModel",
        "title": "Remove Model",
        "category": "Copilot Model Bridge",
        "icon": "$(trash)"
      },
      {
        "command": "copilot-model-bridge.listProviders",
        "title": "List Providers",
        "category": "Copilot Model Bridge",
        "icon": "$(list-unordered)"
      }
    ],
    "configuration": {
      "title": "Copilot Model Bridge",
      "properties": {
        "copilot-model-bridge.providers": {
          "type": "array",
          "default": [],
          "description": "List of configured OpenAI-compatible providers.",
          "items": {
            "type": "object",
            "required": ["id", "displayName", "baseUrl"],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier for this provider (used internally, no spaces)"
              },
              "displayName": {
                "type": "string",
                "description": "Human-readable name for this provider"
              },
              "baseUrl": {
                "type": "string",
                "description": "Base URL of the OpenAI-compatible API endpoint (e.g. https://integrate.api.nvidia.com/v1)"
              },
              "apiKey": {
                "type": "string",
                "default": "",
                "description": "API key for authentication (leave empty if not required)"
              },
              "models": {
                "type": "array",
                "default": [],
                "description": "List of models available from this provider",
                "items": {
                  "type": "object",
                  "required": ["id", "name"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Model ID as expected by the API (e.g. nvidia/llama-3.1-nemotron-ultra-253b-v1)"
                    },
                    "name": {
                      "type": "string",
                      "description": "Human-readable name shown in the model picker"
                    },
                    "maxInputTokens": {
                      "type": "number",
                      "default": 128000,
                      "description": "Maximum input context tokens"
                    },
                    "maxOutputTokens": {
                      "type": "number",
                      "default": 4096,
                      "description": "Maximum output tokens"
                    },
                    "supportsToolCalling": {
                      "type": "boolean",
                      "default": true,
                      "description": "Whether the model supports tool/function calling"
                    },
                    "supportsVision": {
                      "type": "boolean",
                      "default": false,
                      "description": "Whether the model supports image/vision inputs"
                    },
                    "supportsVideo": {
                      "type": "boolean",
                      "default": false,
                      "description": "Whether the model supports video attachments. Video conversion is currently rejected with a clear error."
                    },
                    "supportsFileInput": {
                      "type": "boolean",
                      "default": false,
                      "description": "Whether the model supports non-image file attachments. Unsupported file MIME types are rejected with a clear error."
                    },
                    "supportsEditTools": {
                      "type": "boolean",
                      "description": "Whether the model exposes edit tool hints for Copilot Agent mode. Defaults to supportsToolCalling."
                    },
                    "preferredEditTools": {
                      "type": "array",
                      "description": "Preferred edit tools for file modifications in Agent mode. Leave unset to use the default edit tools.",
                      "items": {
                        "type": "string",
                        "enum": [
                          "find-replace",
                          "multi-find-replace",
                          "apply-patch",
                          "code-rewrite"
                        ]
                      }
                    },
                    "toolChoiceMode": {
                      "type": "string",
                      "default": "required",
                      "enum": [
                        "auto",
                        "required",
                        "none",
                        "omit"
                      ],
                      "description": "OpenAI-compatible tool_choice strategy. required maps VS Code Required to tool_choice=required; auto falls back to auto; none sends none; omit does not send tool_choice."
                    },
                    "supportsReasoning": {
                      "type": "boolean",
                      "default": false,
                      "description": "Whether the model exposes Thinking Effort configuration in the model picker"
                    },
                    "supportedReasoningLevels": {
                      "type": "array",
                      "description": "Reasoning effort levels supported by this model. Leave unset to use all supported levels.",
                      "items": {
                        "type": "string",
                        "enum": [
                          "none",
                          "low",
                          "medium",
                          "high",
                          "xhigh",
                          "max"
                        ]
                      }
                    },
                    "defaultReasoningLevel": {
                      "type": "string",
                      "enum": [
                        "none",
                        "low",
                        "medium",
                        "high",
                        "xhigh",
                        "max"
                      ],
                      "description": "Default reasoning effort when a request does not explicitly provide one"
                    },
                    "multiplier": {
                      "type": "string",
                      "default": "0x",
                      "description": "Request cost multiplier label shown in VS Code model UI, such as 0x, 1x, 0.5x, or High"
                    },
                    "multiplierNumeric": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Numeric form of multiplier for VS Code cost comparisons. If unset, labels like 1x or 0.5x are inferred automatically."
                    },
                    "family": {
                      "type": "string",
                      "description": "Opaque model family shown in VS Code selectors and management surfaces. Defaults to a value inferred from the model id."
                    },
                    "version": {
                      "type": "string",
                      "description": "Opaque model version shown in VS Code selectors."
                    },
                    "categoryLabel": {
                      "type": "string",
                      "description": "Optional category label for newer VS Code model management surfaces."
                    },
                    "categoryOrder": {
                      "type": "number",
                      "description": "Optional category sort order for newer VS Code model management surfaces."
                    },
                    "statusIcon": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9-]*$",
                      "description": "Optional VS Code ThemeIcon id, such as sparkle or warning. The extension ignores unsafe icon ids."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test ./out/test/*.test.js",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0"
  }
}
